# Environment variables (secrets — copy .env.example to .env)
.env

# Data directory (user-specific runtime data)
data/evershelf.db
data/dispensa.db
# Demo databases, one per language (api/lib/demo.php): seeded runtime state, rebuilt daily.
data/demo/
data/*.db-wal
data/*.db-shm
data/backups/
data/cron.log
data/cron.log.*
data/smart_shopping_cache.json
# The demo's per-language smart-shopping cache (api/lib/demo.php).
data/smart_shopping_cache-??.json
data/bring_token.json
data/api_pairing.json
data/bring_catalog.json
data/bring_migrate_ts.json
data/shopping_price_cache.json
data/anomaly_dismissed.json
data/opened_shelf_cache.json
data/shopping_name_cache.json
data/product_kind_cache.json
data/shopping_total_cache.json
data/ai_usage.json
data/classify_daily.json
data/client_debug.log
# Client logs, split by source and day (`data/logs/app-YYYY-MM-DD.log`,
# `data/logs/kiosk-YYYY-MM-DD.log`): runtime state, never committed.
data/logs/
data/rate_limits/
data/mealie/
data/mealie_cache.json
data/cron_health.json
data/*.db.bak*

# Runtime secrets written by the app itself: the Google Drive OAuth state (its hash) and
# the marker that says an API_TOKEN was already generated for this install.
data/gdrive_oauth_state.json
data/api_token_autogen.json
data/med_debug/

# SSL certificates (local only)
data/*.crt
data/*.pem
*.crt
*.pem

# OS files
.DS_Store
Thumbs.db
node_modules/
mcp-server/node_modules/

# Python bytecode
__pycache__/
*.pyc

# Editor / IDE
*.swp
*.swo
*~
.idea/
.vscode/

# Raw screenshots (working folder, not for distribution)
/screenshots/

# Android kiosk build artifacts (generated by Gradle — not source)
evershelf-kiosk/.gradle/
evershelf-kiosk/app/build/
evershelf-kiosk/build/
evershelf-scale-gateway/app/build/
evershelf-scale-gateway/build/
evershelf-kiosk/local.properties
data/error_reports.log
data/latest_release_cache.json
data/food_facts_cache.json
data/category_ai_cache.json
data/weather_cache_*.json
assets/img/logo/*_backup.*
logs/*.log
assets/vendor/transformers/Xenova/

# Local backup / scratch copies (never commit)
*.bak
*.bak.*
*.orig
*.rej

# ── Android signing (never commit real keystores) ──────────────────────────
*.jks
*.keystore
keystore.properties
evershelf-kiosk/keystore.properties
evershelf-health-bridge/keystore.properties
evershelf-kiosk/evershelf.jks
evershelf-health-bridge/evershelf.jks
evershelf-scale-gateway/**/keystore.properties

# ── Pre-built APK artifacts (published via GitHub Releases, not git) ───────
*.apk
!releases/evershelf-kiosk.apk
!releases/*.apk
*.aab

# ── Runtime JSON state written by the app (regenerated, not source) ────────
