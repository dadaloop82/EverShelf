        "zh": ["安瓿", "单剂量", "预充式注射器"]
      }
    },
    {
      "form": "tablets",
      "days": 0,
      "match": {
        "it": ["compresse", "compressa", "capsule", "capsula", "pastiglie", "pastiglia", "bustine", "granulato"],
