{
  "version": 3,
  "note": "Period after opening (PAO) suggested for a medicine, taken from the FORM its name declares. 0 means opening changes nothing (tablets, capsules, suppositories, single-dose containers: the pack date rules). MULTILINGUAL BY DATA: every rule carries its words for the six shipped languages and the reader matches ALL of them, because the NAME comes from the catalogue (AIFA is Italian, openFDA is English) and the UI language may be another one — a German box must work on an Italian phone. Matching is per WHOLE WORD and accent-insensitive («comprime» finds «comprimé»), so «gel» cannot fire on «Angelini». Sources: the PAO symbol printed on the pack (an open jar with the number of months) and standard pharmacy practice for the forms that carry one. A SUGGESTION the household can always edit; the app never gives therapies.",
  "rules": [
    {
      "form": "eye_drops",
      "days": 28,
      "match": {
        "it": ["collirio", "colliri", "gocce oftalmiche", "oculare", "oculari", "unguento oftalmico", "pomata oftalmica", "crema oftalmica"],
        "en": ["eye drop", "eye drops", "eyedrops", "ophthalmic", "eye ointment"],
        "de": ["augentropfen", "augensalbe", "augencreme", "augenbad"],
        "fr": ["collyre", "collyres", "gouttes oculaires", "pommade ophtalmique", "collyre ophtalmique"],
        "es": ["colirio", "colirios", "gotas oftalmicas", "pomada oftalmica"],
        "zh": ["眼药水", "滴眼液", "眼膏", "滴眼剂"]
      }
    },
    {
      "form": "syrup",
      "days": 30,
      "match": {
        "it": ["sciroppo", "sciroppi", "sospensione orale", "sospensione", "soluzione orale", "gocce orali"],
        "en": ["syrup", "syrups", "oral suspension", "suspension", "oral solution", "oral drops"],
        "de": ["saft", "säfte", "suspension", "suspension zum einnehmen", "lösung zum einnehmen", "*saft", "*tropfen", "*suspension"],
        "fr": ["sirop", "sirops", "suspension buvable", "solution buvable", "gouttes buccales"],
        "es": ["jarabe", "jarabes", "suspension oral", "solucion oral", "gotas orales"],
        "zh": ["糖浆", "口服液", "混悬液", "口服滴剂"]
      }
    },
    {
      "form": "nasal_or_balm",
      "days": 90,
      "match": {
        "it": ["spray nasale", "gocce nasali", "balsamo"],
        "en": ["nasal spray", "nasal drops", "balm"],
        "de": ["nasenspray", "nasentropfen", "balsam", "*spray"],
        "fr": ["spray nasal", "gouttes nasales", "baume"],
        "es": ["spray nasal", "gotas nasales", "balsamo"],
        "zh": ["鼻腔喷雾", "滴鼻液", "香膏"]
      }
    },
    {
      "form": "cream_gel",
      "days": 90,
      "match": {
        "it": ["crema", "gel", "unguento", "pomata", "emulsione", "lozione", "spray"],
        "en": ["cream", "gel", "ointment", "emulsion", "lotion", "spray"],
        "de": ["creme", "salbe", "gel", "lotion", "emulsion", "spray", "*salbe", "*creme", "*gel"],
        "fr": ["creme", "gel", "pommade", "emulsion", "lotion", "spray"],
        "es": ["crema", "gel", "pomada", "emulsion", "locion", "spray"],
        "zh": ["乳膏", "凝胶", "软膏", "乳液", "洗剂", "喷雾"]
      }
    },
    {
      "form": "suppository",
      "days": 30,
      "match": {
        "it": ["supposta", "supposte", "ovulo", "ovuli", "gocce"],
        "en": ["suppository", "suppositories", "ovule", "ovules", "pessary", "drops"],
        "de": ["zäpfchen", "ovula", "scheidenzäpfchen", "tropfen", "*zäpfchen"],
