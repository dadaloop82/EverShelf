RewriteEngine On

# Block sensitive files (Apache 2.4+)
<Files ".env">
    Require all denied
</Files>
<Files ".env.example">
    Require all denied
</Files>
<Files "backup.sh">
    Require all denied
</Files>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Build-time configuration. The app reads docker/avahi-evershelf.xml and the Mealie
# compose template from disk, so the directory has to stay in the tree, but nothing
# in it is meant for the web: /docker/php-evershelf.ini and
# /docker/apache-evershelf.conf describe the server setup for free otherwise.
RewriteRule ^docker/ - [F,L]

# ── Never take the server down with a file that is being rewritten ──────────
# Apache memory-maps a file to deliver it, and gzip-compresses app.js (2.1 MB: mod_deflate
# handles text/javascript), which makes the response CHUNKED. When the file is truncated or
# replaced WHILE it is being served — an editor saving it, a `git checkout`, a
# `scripts/bump-version.sh` — the mapped page stops being backed and the CHILD DIES with
# `Bus error (7)`: every response that child was carrying is cut mid-body, and Chrome says
# exactly `net::ERR_INCOMPLETE_CHUNKED_ENCODING 200 (OK)`. Measured on a real deployment:
# with mmap ON a truncated 40 MB .js killed the child (AH00052 Bus error); with `EnableMMAP
# off` the same cut only logs `deflate: failed reading from HEAP bucket` and the child lives
# (the one client loses that response, nobody else does). sendfile stays ON: it is safe and
# fast, only the mapping goes away.
EnableMMAP off

# ── Security headers ────────────────────────────────────────────────────────
# A full CSP is not possible yet (inline handlers, shipped third-party bundles),
# but these are free and close framing / MIME-sniffing / referrer leaks.
#
# The one exception is a DEMO instance: it exists to be embedded by the marketing
# site (an iframe on socly.it and friends), and `index.html` is STATIC — PHP cannot
# relax the header for it. The demo is recognised here by the `/demo/…` mount
# (`DEMO_BASE_PATH`) or by the `?demo=1` flag in the URL (`Request_URI` carries the
# query string); `frame-ancestors` replaces X-Frame-Options, which has no "allow that
# other origin" value. Narrow the list with `EVERSHELF_DEMO_ANCESTORS` if the demo
# should only be framed by specific sites.
SetEnvIf Request_URI "^/demo(/|$)" evershelf_demo=1
# `?demo=1` travels in the QUERY STRING: mod_setenvif only sees the path, so the flag
# is raised by mod_rewrite (which reads `%{QUERY_STRING}` and exports an env var that
# `Header ... env=` honours).
RewriteCond %{QUERY_STRING} (^|&)demo=(1|true|yes|on)(&|$)
RewriteRule ^ - [E=evershelf_demo:1]
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN" env=!evershelf_demo
    Header always unset X-Frame-Options env=evershelf_demo
    Header always set Content-Security-Policy "frame-ancestors *" env=evershelf_demo
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # HSTS only when the request actually arrived over TLS (set by the vhost or proxy).
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    # The CA certificate is a public file offered for download: never let a browser
    # sniff/render it as a document.
    <FilesMatch "\.(crt|cer|pem)$">
        Header set Content-Disposition "attachment"
    </FilesMatch>
</IfModule>

# Force HTTPS (skip when terminated TLS is forwarded — Traefik, Caddy, NPM, …).
# EVERSHELF_CANONICAL_HOST must be set in the Apache vhost (SetEnv) to avoid
# reflecting an attacker-controlled Host header into the redirect (open redirect /
# cache poisoning). Without it no redirect is issued.
RewriteCond %{ENV:EVERSHELF_DISABLE_HTTPS_REDIRECT} !^1$
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteCond %{ENV:EVERSHELF_CANONICAL_HOST} ^[A-Za-z0-9.-]+(:[0-9]+)?$
RewriteRule ^(.*)$ https://%{ENV:EVERSHELF_CANONICAL_HOST}%{REQUEST_URI} [L,R=301]

# API routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/index.php?action=$1&%{QUERY_STRING} [L,QSA]

# Keep JS/CSS fresh for the kiosk — by REVALIDATING, not by re-downloading.
# `no-store` forbade the browser from keeping the file at all, so every boot pulled the whole
# 2.1 MB app.js through a chunked gzip stream again (and every one of those streams was one
# more chance to fail the whole page). The `?v=` stamp (`scripts/bump-version.sh`) is the
# cache key and `no-cache` makes an unchanged boot cost a `304 Not Modified` (a few hundred
# bytes), while a changed file still arrives at once.
#
# `Header unset ETag` is not laziness: mod_deflate publishes `ETag: W/"…-gzip"` but matches
# `If-None-Match` against the tag WITHOUT that suffix, so a browser that keeps the one it was
# given (Chrome sends both validators, and `If-None-Match` wins) never matches and gets the
# whole file again. With the ETag gone the revalidation rides on `Last-Modified`, which
# Apache does answer with a 304 — measured here, not assumed.
<FilesMatch "\.(js|css)$">
    Header unset ETag
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# The shell as well: a stale index.html keeps pointing at the *previous* asset
# stamp, so a deployment could serve an old page next to the new modules (or miss
# a module the new page adds). The service worker still provides the offline shell.
<FilesMatch "^index\.html$">
    Header unset ETag
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>
