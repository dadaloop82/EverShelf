# EverShelf — Configuration
#
# EVERSHELF_ENV_FILE — containers only: where the app reads AND writes this file.
# Default is <app>/.env. Unraid mounts the appdata folder at /config and sets it
# to /config/.env, so the configuration survives container updates and the
# Settings page can save into it. Set it in the container environment: a value
# written *here* is ignored for the path itself (it would be circular).
# EVERSHELF_ENV_FILE=/config/.env
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All settings here can also be changed from the in-app Settings screen and
# will be written back to this file automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI ────────────────────────────────────────────────────────────────────────
# Master switch: if false, no AI feature runs (regardless of keys)
AI_ENABLED=true
# Exclusive provider: gemini | openai | llama
AI_PROVIDER=gemini
# Google Gemini (required when AI_PROVIDER=gemini)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# OpenAI cloud (required when AI_PROVIDER=openai)
# Default base URL if empty: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Llama local/remote OpenAI-compatible (required when AI_PROVIDER=llama)
# Examples:
#   Ollama:           http://127.0.0.1:11434/v1
#   Ollama (Docker):  http://host.docker.internal:11434/v1
#   llama.cpp / vLLM: http://127.0.0.1:8080/v1
LLAMA_BASE_URL=
LLAMA_API_KEY=
LLAMA_MODEL=llama3.2

# ── Shopping list ─────────────────────────────────────────────────────────────
# SHOPPING_MODE: internal = EverShelf built-in list (default, recommended)
#                bring    = optional mirror of that list to the Bring! app
# The shopping list always lives in EverShelf. Bring! never replaces it.
SHOPPING_MODE=internal
# SHOPPING_ENABLED: the shopping list page exists at all (default true).
SHOPPING_ENABLED=true
# SHOPPING_SMART_SUGGESTIONS: propose rows from stock, usage and expiry (default true).
SHOPPING_SMART_SUGGESTIONS=true
# SHOPPING_FORECAST: add the "ends in N days" prediction to the suggested rows.
SHOPPING_FORECAST=true
# SHOPPING_AUTO_ADD_THRESHOLD: stock at or below this many units lands on the list
# by itself (0 = only when the product is finished).
SHOPPING_AUTO_ADD_THRESHOLD=0
# RECIPE_SHOPPING_MODE: off | ask | auto — what a recipe with missing ingredients does
# with the shopping list.
RECIPE_SHOPPING_MODE=off
# Remove list row after inventory_add: plan | trip. Empty = not decided yet (setup checklist asks).
# SHOPPING_REMOVE_ON_BUY=
# After Comprato: suppress auto re-add until that product is finished again.
# After Rimuovi (not bought): suppress only for the rest of that calendar month.
# SHOPPING_REMOVED_BLOCK_MODE=month
# Optional day-based mode for Rimuovi only:
# SHOPPING_REMOVED_BLOCK_MODE=days
# SHOPPING_REMOVED_BLOCK_DAYS=15
# A "Non lo compro" (shopping_remove with purchased=false) also stores a dated DISMISS
# that the cron respects — the purchase block alone let depleted products back in.
# Days it lasts (1–365); a client may override per call with `dismiss_days`.
# SHOPPING_DISMISS_DAYS=14
# Bring! credentials — only needed when SHOPPING_MODE=bring (leave empty otherwise)
BRING_EMAIL=
BRING_PASSWORD=

# ── Text-to-Speech (TTS) ─────────────────────────────────────────────────────
# Works with Home Assistant, a local TTS server, or any HTTP endpoint.
# TTS_ENABLED: master switch (true/false)
TTS_ENABLED=false
# TTS_URL: endpoint that receives the text payload. Also acts as the SSRF
# allowlist entry for ?action=tts_proxy together with HA_URL.
TTS_URL=
# TTS_ALLOWED_HOSTS: extra comma-separated hosts the tts_proxy may reach
# (the HA_URL and TTS_URL hosts are always allowed; private LAN hosts on the
# server's own subnet are allowed automatically). Example: ha.local,192.168.1.50
TTS_ALLOWED_HOSTS=
# TTS_INSECURE_SSL: set to true ONLY to accept self-signed TLS certs on the LAN
# (default false = verify certificates). Prefer adding your CA to the trust store.
TTS_INSECURE_SSL=false
# TTS_TOKEN: Authorization token sent as Bearer header (or empty)
TTS_TOKEN=
# TTS_METHOD: HTTP method (POST or GET)
TTS_METHOD=POST
# TTS_AUTH_TYPE: how the token is sent (bearer | basic | none)
TTS_AUTH_TYPE=bearer
# TTS_CONTENT_TYPE: request Content-Type header
TTS_CONTENT_TYPE=application/json
# TTS_PAYLOAD_KEY: JSON key that carries the text (e.g. "message", "text")
TTS_PAYLOAD_KEY=message
# TTS_ENGINE: preferred browser TTS engine ('browser', 'server', 'custom') — optional
TTS_ENGINE=
# TTS_RATE / TTS_PITCH: speech rate and pitch multipliers (1 = normal)
TTS_RATE=1
TTS_PITCH=1
# TTS_AUTH_HEADER_NAME / VALUE: custom HTTP header for authentication (optional)
TTS_AUTH_HEADER_NAME=
TTS_AUTH_HEADER_VALUE=
# TTS_EXTRA_FIELDS: additional JSON fields as key=value pairs, comma-separated (optional)
TTS_EXTRA_FIELDS=

# ── User preferences ─────────────────────────────────────────────────────────
# These mirror the toggle switches in the Settings screen.
# APP_LANG: the language the SERVER uses for AI text and product titles when the
# client sends none (it, en, de, fr, es, zh). Empty = the browser's language. The UI
# language is per device (?lang= or Settings → Generali → Lingua).
# APP_LANG=
DEFAULT_PERSONS=1
# DARK_MODE: off | auto | on — the theme of the interface (Settings → Generali → Tema).
DARK_MODE=auto
PREF_VELOCE=false
PREF_POCAFAME=false
PREF_SCADENZE=true
PREF_HEALTHY=false
PREF_OPENED=true
PREF_ZEROWASTE=false
PREF_FUEL=false
# HEALTH_ENABLED: master switch for personal/biological data + Fuel Mode + Health Bridge
HEALTH_ENABLED=false
# Dietary restrictions shown to the AI (e.g. "vegetariano,senza glutine")
DIETARY=
# ZEROWASTE_TIPS_ENABLED: cooking mode suggests how to reuse the scraps of each step.
# Empty = not decided yet (the setup checklist asks once).
# ZEROWASTE_TIPS_ENABLED=
# NO_EXPIRY_BANNER_ENABLED: the «no expiry date» notice on the Home for items with no
# best-before date. true (default) = shown; false = the whole reason is switched off,
# for every product and every device (Settings → Aspetto). «Non serve la scadenza»
# on a single product keeps working either way.
NO_EXPIRY_BANNER_ENABLED=true

# ── Appliances ────────────────────────────────────────────────────────────────
# Comma-separated list of appliances available in your kitchen.
# Used by the AI when generating recipes.
APPLIANCES=Forno,Microonde,Friggitrice ad aria,Pentola a pressione
# Extra storage places beyond Pantry/Fridge/Freezer/Other (comma-separated display names)
# Example: CUSTOM_LOCATIONS=Cantina,Box garage,Borsa frigo
CUSTOM_LOCATIONS=

# ── Camera ───────────────────────────────────────────────────────────────────
# Default camera for barcode scanning ('environment' = rear, 'user' = front)
CAMERA_FACING=environment

# ── Smart Kitchen Scale ───────────────────────────────────────────────────────
# SCALE_ENABLED: enables the scale integration
SCALE_ENABLED=false
# SCALE_GATEWAY_URL: address of the EverShelf Scale Gateway (Android app)
SCALE_GATEWAY_URL=

# ── Barcode lookups ───────────────────────────────────────────────────────────
# UPC_LOOKUP_ENABLED: also ask UPCitemdb's TRIAL endpoint (commercial, rate-limited,
# not a free/open service). Off by default: the free sources (Open Food Facts,
# Open Products/Beauty/Pet Food Facts) answer first and are the ones credited.
UPC_LOOKUP_ENABLED=false

# ── EverShelf Med (opt-in medicine cabinet) ───────────────────────────────────
# MED_ENABLED: turn on the medicines module (also switchable in Settings → Salute).
#
# The medicine catalogue is LOCAL: `med_catalog_sync` imports the official AIFA "confezioni"
# export (~160k packs) and a scan is verified against that table — no key, no quota, works with
# no signal. These two keys add an OPTIONAL online lookup, used only for a code the local
# catalogue does not contain; the answer is then cached in the local table. Leave them commented
# unless you have a key you want to use.
# MED_LOOKUP_PROVIDER=medifontis
# MED_LOOKUP_URL=https://api.medifontis.com/v1/drugs
# MED_LOOKUP_KEY=
# Off by default. It adds medical locations, the expired-medicine block and the offline
# symptom search, and never mixes medicines with food, recipes or shopping suggestions.
MED_ENABLED=false

# ── Meal Plan ────────────────────────────────────────────────────────────────
# MEAL_PLAN_ENABLED: show the weekly meal planner tab in Settings
MEAL_PLAN_ENABLED=false

# ── Screensaver (kiosk / tablet mode) ────────────────────────────────────────
SCREENSAVER_ENABLED=false
# SCREENSAVER_TIMEOUT: MINUTES of inactivity before the idle screen appears (1-60, default 5).
# Older installations wrote this in SECONDS (300 = five minutes): a value above 60 is still
# read as seconds and converted, so an existing file keeps working unchanged.
SCREENSAVER_TIMEOUT=5
# SCREENSAVER_VIEWS: which cards the idle screen shows, in a comma list — meal, alerts,
# nutrition, fact (empty = all of them). A view with nothing to say is skipped by itself.
SCREENSAVER_VIEWS=meal,alerts,nutrition,fact
# SCREENSAVER_INTERVAL: seconds between two cards of the idle screen (10-300, default 30;
# the card leaves upward and the next one comes down from the top)
SCREENSAVER_INTERVAL=30

# ── Weather (needed by the "A ritmo mio" recipe mode) ────────────────────────
# Pick the place once from Settings → Cucina → Ricette: the app stores the
# coordinates it geocoded, so the forecast is right for your kitchen.
WEATHER_ENABLED=false
# WEATHER_LAT / WEATHER_LON: coordinates of the kitchen (decimal degrees).
WEATHER_LAT=
WEATHER_LON=
# WEATHER_CITY: the label shown in the settings card ("Milano, IT").
WEATHER_CITY=

# ── Support & optional monetisation ──────────────────────────────────────────
# The app is free and complete either way: this block only decides whether the
# one-off "support the project" dialog offers a donation link or nothing for now.
# Full walkthrough: docs/wiki/Support-and-ads.md.
#
# SUPPORT_MODE: donate | later   (empty = never asked → "later" applies)
SUPPORT_MODE=
# SUPPORT_DECIDED: set to true by the app as soon as the household answered. The
# answer then stands for a month: after that the dialog may come back on a random
# start (one boot in four), never on a schedule. It is only changed on purpose
# under Settings → Info.
SUPPORT_DECIDED=false
# SUPPORT_ANSWERED_AT: unix seconds of the last answer, written by the dialog with
# the answer itself. It is the clock the month is counted from (0 = an answer stored
# before this key existed: the app starts it on the next start).
SUPPORT_ANSWERED_AT=
#
# PayPal. Paste the link of your donation page — a PayPal.me handle or a hosted
# donate button both work — plus the amounts you want to offer as buttons. With
# no link configured the dialog still offers "later".
SUPPORT_PAYPAL_URL=
SUPPORT_PAYPAL_CURRENCY=EUR
SUPPORT_PAYPAL_AMOUNTS=5,10,25
#
# The running costs the dialog discloses. Leave a line at 0 to hide it; the
# dialog also shows what they add up to per month, so the numbers must stay true.
SUPPORT_COST_CURRENCY=EUR
SUPPORT_COST_HOSTING=0
SUPPORT_COST_DOMAIN=0
SUPPORT_COST_DEVACCOUNT=0
SUPPORT_COST_API=0
#
# ── PARKED: banner slots (dashboard + screensaver) — not used ────────────────
# EverShelf does not run advertising: the two banner answers are gone from the
# dialog, the slots are commented out of index.html and _renderAdSlots() is a
# no-op. These keys are kept documented so re-enabling the feature is a matter of
# restoring code, not of re-inventing the configuration — see "Banner slots
# (parked)" in docs/wiki/Support-and-ads.md. Nothing here is read while parked.
# SUPPORT_BANNERS_AVAILABLE: offer the two banner answers at all (was: off by
# default, the answers greyed out while false).
# SUPPORT_BANNERS_AVAILABLE=false
# ADS_PROVIDER: house = EverShelf's own banner (no account needed)
#               adsense = Google AdSense: set the client id and both slot ids
#               custom  = paste any network's markup in ADS_CUSTOM_*_HTML
#               none    = no banner anywhere, whatever the answer was
# ADS_PROVIDER=house
# ADSENSE_CLIENT=
# ADSENSE_SLOT_APP=
# ADSENSE_SLOT_SCREENSAVER=
# Raw markup of another network (Amazon Associates, EthicalAds, Ezoic…). These two
# were .env only on purpose: never writable through the API.
# ADS_CUSTOM_APP_HTML=
# ADS_CUSTOM_SCREENSAVER_HTML=

# ── Price estimates ───────────────────────────────────────────────────────────
# PRICE_ENABLED: show estimated price column on the shopping list (empty = not decided)
PRICE_ENABLED=false
# PRICE_SOURCE: auto | open_prices | ai  (Open Prices = free OFF crowdsourced barcodes)
PRICE_SOURCE=auto
# PRICE_COUNTRY: country used for price context (e.g. "Italia", "Germany")
PRICE_COUNTRY=Italia
# Browser Web Push (empty-payload wake + inbox). Requires HTTPS. Empty = not decided.
# WEB_PUSH_ENABLED=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_PEM=
# PRICE_CURRENCY: ISO 4217 currency code (e.g. EUR, USD, GBP)
PRICE_CURRENCY=EUR
# PRICE_UPDATE_MONTHS: how many months to cache a price before re-fetching (default 3)
PRICE_UPDATE_MONTHS=3

# ── Cleanup / retention ──────────────────────────────────────────────────────
# RECIPE_RETENTION_DAYS: delete auto-generated recipe plans older than N days
RECIPE_RETENTION_DAYS=7
# TRANSACTION_RETENTION_DAYS: keep stock transaction history for N days.
# Smart Shopping uses this history to compute purchase frequencies.
# WARNING: values below 30 will cause the shopping list to appear nearly empty.
# Minimum enforced at runtime: 30 days.
TRANSACTION_RETENTION_DAYS=90
# VACUUM_EXPIRY_EXTENSION_DAYS: a vacuum-packed product lasts this much longer than the
# shelf life of its category (Settings → Sistema → Dati). 0 disables the extension.
VACUUM_EXPIRY_EXTENSION_DAYS=30

# ── Local Backup ─────────────────────────────────────────────────────────────
# BACKUP_ENABLED: run a daily incremental backup via cron (true/false)
BACKUP_ENABLED=true
# BACKUP_RETENTION_DAYS: keep local backups for N days (minimum 1)
BACKUP_RETENTION_DAYS=3

# ── Google Drive Backup ───────────────────────────────────────────────────────
# GDRIVE_ENABLED: upload the daily backup to Google Drive (requires a service account)
GDRIVE_ENABLED=false
# GDRIVE_CLIENT_ID / GDRIVE_CLIENT_SECRET: OAuth client of "Drive" uploads done with a
# user account instead of a service account (Settings → Sistema → Backup). Empty = the
# service account above is used.
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
#
# Setup steps:
#   1. Create a Google Cloud project and enable the Drive API
#   2. Create a Service Account and download the JSON key
#   3. Create a Drive folder and share it with the service account email
#   4. Paste the JSON content below (or set GDRIVE_SERVICE_ACCOUNT_FILE to the path)
#   5. Set GDRIVE_FOLDER_ID to the Drive folder ID (from its URL)
#
# GDRIVE_SERVICE_ACCOUNT_JSON: full JSON content of the service account key
GDRIVE_SERVICE_ACCOUNT_JSON=
# GDRIVE_SERVICE_ACCOUNT_FILE: alternative — path to the service account JSON file
GDRIVE_SERVICE_ACCOUNT_FILE=
# GDRIVE_FOLDER_ID: ID of the Drive folder where backups will be stored
GDRIVE_FOLDER_ID=
# GDRIVE_RETENTION_DAYS: delete Drive backups older than N days (0 = keep all)
GDRIVE_RETENTION_DAYS=30

# ── Security ─────────────────────────────────────────────────────────────────
# API_TOKEN: when set, all API calls require header X-API-Token (or ?api_token= for HA).
# SETTINGS_TOKEN: legacy alias — use API_TOKEN for new installs.
# Leave it EMPTY only on a machine that is not reachable by anything else: an empty token
# means "no authentication at all". EverShelf mints one on the first start and prints the
# one-time pairing code in the log (Settings → System → Security shows it on a paired
# device). ALLOW_OPEN_LAN=true keeps the old, unauthenticated behaviour on purpose.
API_TOKEN=
SETTINGS_TOKEN=
# ALLOW_OPEN_LAN: true = do NOT generate an API_TOKEN when the install has none (a fully
# trusted LAN, or a reverse proxy that authenticates for you). Everyone who can reach the
# port reads and writes the pantry. See SECURITY.md.
ALLOW_OPEN_LAN=false
# ALLOWED_HOSTS: the names this server answers to — the DNS-rebinding guard. Empty = off.
# Note the browser cannot protect you here: a page on evil.example can point its own DNS at
# your LAN address, and CORS/Sec-Fetch-Site are then satisfied because the request really is
# on evil.example. List every name you browse to, comma separated; *.example.lan matches
# subdomains and is never implied.
# Example: ALLOWED_HOSTS=evershelf.local,192.168.1.10,evershelf.example.com
ALLOWED_HOSTS=

# CORS_ORIGIN: comma-separated allowed origins (empty = same-origin only, no wildcard)
CORS_ORIGIN=
# TRUSTED_PROXIES: comma-separated IPs/CIDRs of reverse proxies that set
# X-Forwarded-For (e.g. 172.18.0.0/16,10.0.0.5). Without this the rate limiter
# uses the direct peer address so a client can never spoof its own bucket.
TRUSTED_PROXIES=
# API_BOOTSTRAP_OPEN: true = hand API_TOKEN to any same-origin-looking request
# (legacy behaviour). Default false: the UI must present the one-time pairing code
# printed in the server log. Only enable on a fully trusted LAN — it re-exposes the
# token to anyone who can reach the port. See SECURITY.md.
API_BOOTSTRAP_OPEN=false

# GitHub automatic issue reporting (encrypted storage recommended)
# Option A — plain ( .env is gitignored ):
# GH_ISSUE_TOKEN=ghp_...
# Option B — encrypted (php scripts/encrypt-gh-token.php 'ghp_...' 'secret-key'):
GH_ISSUE_TOKEN=
GH_ISSUE_TOKEN_ENC=
GH_ISSUE_TOKEN_KEY=

# REPORT_ENABLED: publish error/bug reports as GitHub issues.
# Off by default — issues are opened on a PUBLIC repository, so publishing is an
# explicit opt-in on top of configuring GH_ISSUE_TOKEN above (a token left in a
# shared .env is not enough on its own). Diagnostics are never lost either way:
# data/error_reports.log is always written, locally and redacted.
# Whatever the setting, before anything is sent the report is redacted
# (api_token=…, Authorization: …, ghp_… → [REDACTED]) and the context is capped
# at 4 KB.
REPORT_ENABLED=false

# NOTE: Run `php scripts/migrate-env-security.php` once after upgrading to migrate legacy tokens.

# INSTANCE_NAME: display name for this EverShelf instance (used by the HA integration
# for Zeroconf discovery label and device name in Home Assistant).
# Defaults to the server hostname if left empty.
INSTANCE_NAME=

# ── Home Assistant Integration ────────────────────────────────────────────────
# All HA settings can also be configured from the Settings → 🏠 tab.
#
# HA_ENABLED: master switch for all HA features (webhooks, TTS, sensors)
HA_ENABLED=false
# HA_URL: base URL of your HA instance — no trailing slash
# Examples: http://homeassistant.local:8123  or  http://192.168.1.50:8123
HA_URL=
# HA_TOKEN: Long-Lived Access Token (HA Profile → Security → Long-Lived Access Tokens)
HA_TOKEN=
# HA_TTS_ENTITY: media_player entity for recipe step TTS (e.g. media_player.living_room)
HA_TTS_ENTITY=
# HA_WEBHOOK_ID: ID of an HA automation's Webhook trigger
HA_WEBHOOK_ID=
# HA_WEBHOOK_EVENTS: comma-separated events to fire webhooks for
#   Available: expiry, shopping_add, stock_update, barcode_scan
HA_WEBHOOK_EVENTS=expiry,shopping_add,stock_update
# HA_NOTIFY_SERVICE: HA notify service for push alerts (e.g. notify.mobile_app_my_phone)
HA_NOTIFY_SERVICE=
# HA_EXPIRY_DAYS: days before expiry to trigger expiry alert (default 3)
HA_EXPIRY_DAYS=3
# EXPIRY_ALERT_HOUR: hour of the day (0-23, server local time) when the daily expiry
# alert runs — the same check feeds Home Assistant and the ntfy/webhook channels.
# Empty = first cron pass after midnight, which on a UTC container is the previous
# evening for the Americas. Example: 8 = alerts in the morning, local time.
EXPIRY_ALERT_HOUR=

# ── Notifications — ntfy / generic webhook (no Home Assistant required) ───────
# Everything below can also be configured from Settings → 🔔 Notifiche, which is
# the recommended way: it validates the topic, never echoes a stored token back
# and can send a test notification (action=notify_test).
#
# NOTIFY_ENABLED: master switch for the ntfy and webhook channels only.
# HA_NOTIFY_SERVICE / HA_WEBHOOK_ID above keep working independently.
NOTIFY_ENABLED=false
# NOTIFY_CHANNELS: comma-separated channels to deliver to.
#   Available: ntfy, webhook
NOTIFY_CHANNELS=ntfy
# NOTIFY_EVENTS: comma-separated events — same names as HA_WEBHOOK_EVENTS.
#   Available: expiry_alert, shopping_add, stock_update (or the literal "all")
NOTIFY_EVENTS=expiry_alert
# NOTIFY_LANGUAGE: language of the message text built server-side.
#   it / en / de / fr / es / zh (empty or unknown = en). Only affects the text
#   the server sends; the web UI keeps following the browser language.
NOTIFY_LANGUAGE=en
# NTFY_URL: ntfy server — the public one, or your self-hosted instance.
NTFY_URL=https://ntfy.sh
# NTFY_TOPIC: name of the topic to publish to (letters, digits, dash, underscore;
# max 64). Anyone who knows it can read and publish: treat it like a password.
NTFY_TOPIC=
# NTFY_TOKEN: only for an ntfy server that requires authentication (Bearer).
NTFY_TOKEN=
# NTFY_PRIORITY: 1–5 or min/low/default/high/urgent; an unknown value falls back to 3.
NTFY_PRIORITY=default
# NTFY_TAGS: comma-separated ntfy tags, shown as an icon next to the notification.
NTFY_TAGS=ever-shelf
# NOTIFY_WEBHOOK_URL: POST target for a JSON delivery (n8n, Node-RED, Gotify, …).
NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_TOKEN: optional token sent to the webhook.
NOTIFY_WEBHOOK_TOKEN=
# NOTIFY_WEBHOOK_HEADER: header carrying that token (default: Authorization).
NOTIFY_WEBHOOK_HEADER=Authorization
# NOTIFY_INSECURE_SSL: accept self-signed TLS certificates (LAN servers only).
NOTIFY_INSECURE_SSL=false

# NOTIFY_HEALTHCHECK_URL: cron watchdog (dead-man's switch) ping URL. Optional and
# a no-op when empty — the cron jobs simply skip the ping. Point it at either:
#   Healthchecks.io   https://hc-ping.com/<uuid>               (free, no card)
#   Uptime Kuma       https://kuma.example/api/push/<token>    (self-hosted)
# The URL shape picks the protocol: without a query string the state is a path
# suffix (…/<uuid>, …/<uuid>/fail, …/<uuid>/start) and the detail is the POST body;
# with a query string "&status=up|down&msg=<detail>" is appended and the request is
# a GET. Whoever knows the URL can silence the alarm: treat it like a password (it
# is never logged and never returned by the API). Uptime Kuma on a self-signed LAN
# host needs NOTIFY_INSECURE_SSL=true above.
NOTIFY_HEALTHCHECK_URL=
# NOTIFY_HEALTHCHECK_URL_<JOB>: optional per-job override of the URL above.
#   Jobs: SMART_SHOPPING, BARCODE_CATALOG, MEALIE_CACHE
#   e.g. NOTIFY_HEALTHCHECK_URL_SMART_SHOPPING=https://hc-ping.com/<uuid>

# ── Telegram bot (optional household client) ─────────────────────────────────
# Webhook URL: https://your-host/api/index.php?action=telegram_webhook
# The webhook cannot present the API token (Telegram calls it), so it is authenticated by
# the secret Telegram itself echoes back. Register it once with:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#        -d "url=https://your-host/api/index.php?action=telegram_webhook" \
#        -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
# Without it the only gate is the chat allowlist — and with an EMPTY allowlist the webhook
# now refuses to run at all (it answered any chat id before).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOWED_CHAT_IDS=123456789

# ── Calendar feed (ICS / WebCal) ──────────────────────────────────────────────
# Subscribe to the pantry expiries from Google Calendar, Apple Calendar, Thunderbird…
# Configure it from Settings → 🗓️ Calendar, which mints ICS_TOKEN for you.
#
# ICS_ENABLED: master switch. When false the feed answers 404.
ICS_ENABLED=false
# ICS_TOKEN: read-only secret for the feed URL (?action=calendar_ics&token=…).
# Rotate it from Settings to revoke every existing subscription. Never logged.
ICS_TOKEN=
# ICS_DAYS: how many days ahead to publish (1–365, default 30)
ICS_DAYS=30
# ICS_PAST_DAYS: keep items expired up to N days visible (0–60, default 7)
ICS_PAST_DAYS=7

# BARCODE_AI_FALLBACK: when true, ask Gemini for unknown barcodes (needs GEMINI_API_KEY)
BARCODE_AI_FALLBACK=true
# BARCODE_OFFLINE_ENABLED: keep a local barcode catalog for offline lookup
BARCODE_OFFLINE_ENABLED=true
# BARCODE_OFFLINE_SYNC_DAYS: refresh catalog from free APIs every N days (cron)
BARCODE_OFFLINE_SYNC_DAYS=7
# BARCODE_LOOKUP_TIMEOUT: seconds per parallel HTTP lookup wave (4–20)
BARCODE_LOOKUP_TIMEOUT=8

# ── Developer / demo ─────────────────────────────────────────────────────────
# DEMO_MODE: force demo mode on this installation. Every write is blocked, no API
#   token is ever minted here and the app answers from its OWN seeded database
#   (`data/demo/evershelf-demo-<lang>.db`) — the household's pantry is never opened.
#   The same mode can be switched per visitor with `?demo=1` on any URL; the demo is
#   English by default and follows `?lang=it|en|de|fr|es|zh`.
DEMO_MODE=false
# DEMO_BASE_PATH: the URL prefix that marks a demo deployment (default /demo). Every
#   request served under it is a demo (e.g. https://evershelf.site/demo). Empty or `/`
#   switches the path rule off, leaving only DEMO_MODE / ?demo=1.
DEMO_BASE_PATH=/demo
# DEMO_FRAME_ANCESTORS: which sites may embed the demo in an iframe (sent as the CSP
#   `frame-ancestors` directive, default `*`). Set the marketing site's origin to
#   narrow it, e.g. `https://www.socly.it https://socly.it`.
DEMO_FRAME_ANCESTORS=*

# DISPLAY_ERRORS: 1 = surface PHP notices/errors in responses (debugging only).
# Keep 0 in production so HTML notices never break JSON API responses.
DISPLAY_ERRORS=0

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO | WARN | ERROR (default INFO)
#   Applies to the SERVER log (logs/evershelf_*) AND to what the clients are allowed to store:
#   with INFO the three operational levels (info/warn/error) are kept, with WARN only warn/error,
#   with DEBUG also the debug lines. The clients themselves default to `info`; open the app with
#   `?log=debug` (or set localStorage.evershelf_log_level) to raise one device for an afternoon.
LOG_LEVEL=INFO
# EVERSHELF_LOG_KEEP_DAYS: how many days of client logs to keep (default 14).
#   Client lines go to data/logs/<source>-YYYY-MM-DD.log, one river per source:
#     app-*.log    phones, tablets, desktops
#     kiosk-*.log  the Android kiosk (its WebView lines AND its native reports)
#   A kiosk WebView reports `Android` in its User-Agent exactly like a phone, which is why the
#   source is now declared by the client instead of guessed from the header.
EVERSHELF_LOG_KEEP_DAYS=14
# LOG_ROTATE_HOURS: new log file every N hours (1–168, default 24)
LOG_ROTATE_HOURS=24
# LOG_MAX_FILES: max rotated log files kept (default 14)
LOG_MAX_FILES=14

# ── AI cost accounting (optional overrides, USD per 1M tokens) ───────────────
# GEMINI_COST_25F_IN=0.15
# GEMINI_COST_25F_OUT=0.60
# GEMINI_COST_20F_IN=0.10
# GEMINI_COST_20F_OUT=0.40
# GEMINI_COST_35F_IN=1.50
# GEMINI_COST_35F_OUT=9.00
# GEMINI_CLASSIFY_DAILY_MAX: hard cap on shopping-name classify calls per day (default 40)
GEMINI_CLASSIFY_DAILY_MAX=40

# ── Product rules: genre in the title + automatic favourites ─────────────────
# PRODUCT_KIND_PREFIX: true (default) puts the genre in front of every article
# title ("Fiori di latte" → "Yogurt Fiori di latte"). The genre comes from the
# built-in dictionary and, only when the name does not say it, from one cached AI
# word per product family. false = leave the titles exactly as typed/scanned.
PRODUCT_KIND_PREFIX=true

# TAGS_ENABLED: true (default) unlocks free-form product tags (#97): pills on the
# card and a filter bar above the pantry. false hides the field and answers the
# tag endpoints as if none existed.
TAGS_ENABLED=true

# Quick stocktake (#285) is not a switch any more: the banner lives in the pantry, on the
# place you have open, and it is always available.
# AUDIT_MODE_BATCH_SIZE: how many answers are written in one go during a
# stocktake (1-50). Smaller = fewer changes lost on a broken connection.
AUDIT_MODE_BATCH_SIZE=5

# PRODUCT_VARIANTS_ENABLED: true (default) unlocks parent / child products (#284):
# a generic product (Spaghetti) with its variants (Barilla, Rummo), each keeping
# its own brand, barcode and stock while the family total is shown on the card.
PRODUCT_VARIANTS_ENABLED=true

# RECEIPT_OCR_ENABLED: true (default) shows the receipt button on the scan page
# (#114). The model only proposes rows; nothing is written until the review table
# is confirmed.
RECEIPT_OCR_ENABLED=true
# RECEIPT_OCR_MAX_ITEMS: how many lines one photo may return (1-200).
RECEIPT_OCR_MAX_ITEMS=60
# AUTO_FAVORITE_MIN_USES: floor of consumptions before a product can compete
# for an automatic favourite slot (default 3, 0 = off). A manual un-star always
# wins over this rule.
AUTO_FAVORITE_MIN_USES=3
# AUTO_FAVORITE_TOP_N: only the absolute top-N most-used products (that also
# clear MIN_USES) get the automatic star. Default 3 — not every staple.
AUTO_FAVORITE_TOP_N=3
# AUTO_FAVORITE_WINDOW_DAYS: rolling window those consumptions are counted in
# (default 90, matching the usage_count of recent_popular_products).
AUTO_FAVORITE_WINDOW_DAYS=90

# CRON_LOG_MAX_BYTES: rotate data/cron.log when larger (default 524288 = 512 KB)
CRON_LOG_MAX_BYTES=524288

# ── Mealie (recipe manager) ───────────────────────────────────────────────────
# Mealie is free open-source software — self-host at https://mealie.io
# RECIPE_SOURCE: gemini | mealie | auto (default auto when Mealie/cache available)
RECIPE_SOURCE=auto
# MEALIE_OFFLINE: false=always online | true=cache only | auto=fallback to cache
MEALIE_OFFLINE=auto
MEALIE_CACHE_SYNC_DAYS=7
# MEALIE_RECIPE_MAX_MISSING: how many ingredients a recipe from the Mealie book may lack
# before it is refused (0 = only recipes the pantry can cook completely, the default).
# MEALIE_RECIPE_MAX_MISSING=0
# MEALIE_URL=https://mealie.example.com
# MEALIE_API_TOKEN=your-mealie-api-token

# ── MCP HTTP (remote AI agents) ───────────────────────────────────────────────
# Run: cd mcp-server && npm run start:http
# MCP_HTTP_PORT=8787
# MCP_HTTP_TOKEN=choose-a-long-random-secret
