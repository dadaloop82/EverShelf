    <string name="wiz_sync_title">Première synchronisation</string>
    <string name="wiz_sync_body">Nous lisons aujourd\'hui depuis Health Connect et le mettons en file pour EverShelf. Rien n\'est envoyé avant que le serveur réponde.</string>
