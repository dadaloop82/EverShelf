    <string name="app_name">EverShelf Health</string>
    <string name="privacy_policy">EverShelf Health Bridge liest tägliche Aggregate (Schritte, Kalorien, Training, Schlaf) über Health Connect und sendet sie an deinen EverShelf-Server im lokalen Netz. Kein Roh-GPS. Berechtigungen jederzeit widerrufbar.</string>
