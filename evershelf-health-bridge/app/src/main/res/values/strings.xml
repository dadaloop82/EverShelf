    <string name="wiz_sync_title">First sync</string>
    <string name="wiz_sync_body">We\'ll read today from Health Connect and queue it for EverShelf. Nothing is uploaded until the server answers.</string>
    <string name="wiz_sync_btn">Sync now</string>
    <string name="wiz_sync_running">Syncing…</string>
