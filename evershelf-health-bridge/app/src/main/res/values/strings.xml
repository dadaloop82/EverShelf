<resources>
    <string name="app_name">EverShelf Health Bridge</string>
    <string name="privacy_policy">EverShelf Health Bridge reads daily aggregates and biometrics (steps, calories, exercise, sleep, heart rate, oxygen saturation, weight, hydration and more) via Health Connect and sends them ONLY to your own EverShelf server, and only when that server answers. No GPS track, no cloud, no analytics. You can revoke every permission at any time.</string>

