    <string name="app_name">EverShelf Health</string>
    <string name="privacy_policy">EverShelf Health Bridge reads daily aggregates (steps, calories, exercise, sleep) via Health Connect and sends them to your EverShelf server on the local network. No raw GPS. You can revoke permissions anytime.</string>

    <string name="wizard_exit_title">Exit setup?</string>
