    <string name="wiz_goals_title">Your goals</string>
    <string name="wiz_goals_body">They drive the rings on Today. Steps and burned calories are your own numbers, not ours.</string>
    <string name="wiz_diag_title">Privacy &amp; diagnostics</string>
    <string name="wiz_diag_body">Health data never leaves your network. Crashes and failed uploads are written to the local log; you can also send them to your EverShelf server.</string>
