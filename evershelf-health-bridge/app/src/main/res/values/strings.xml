    <string name="wiz_perms_granted">Permissions look good — continue</string>
    <string name="wiz_perms_partial">Some permissions missing — you can continue and fix later</string>
    <string name="wiz_pair_title">Link EverShelf</string>
    <string name="wiz_pair_body">On the computer/tablet open EverShelf → Settings → Health → create a Bridge token, then scan the QR. It carries the server URL and the token together.</string>
