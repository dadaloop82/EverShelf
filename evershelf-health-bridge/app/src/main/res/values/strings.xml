    <string name="wiz_welcome_title">Your body, your pantry</string>
    <string name="wiz_welcome_body">This app bridges Health Connect with EverShelf so recipes can follow what you burned today.\n\nIt uploads ONLY while your EverShelf server answers: outside the house, on mobile data without VPN, nothing leaves the phone — the days wait in a local queue and are sent the moment you are back.\n\nEverything stays on your network. Optional and private.</string>
    <string name="wiz_perms_title">Health permissions</string>
    <string name="wiz_perms_body">We only need READ access. The more you grant, the richer your diary and charts: activity, sleep, heart, oxygen, body composition.\n\nTap below to open Health Connect and allow EverShelf Health Bridge.</string>
    <string name="wiz_perms_btn">Grant Health Connect access</string>
