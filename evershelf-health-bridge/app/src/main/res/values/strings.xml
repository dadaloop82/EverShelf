    <string name="wiz_welcome_title">Fuel your kitchen</string>
    <string name="wiz_welcome_body">This app bridges Health Connect / Google Fit with EverShelf so recipes can match what you burned today.\n\nEverything stays on your Wi‑Fi. Optional and private.</string>

    <string name="wiz_perms_title">Health permissions</string>
    <string name="wiz_perms_body">We only need read access to daily activity: steps, calories, exercise, sleep, weight.\n\nTap below to open Health Connect and allow EverShelf Health.</string>
