    <string name="app_name">EverShelf Health</string>
    <string name="privacy_policy">EverShelf Health Bridge legge aggregati giornalieri (passi, calorie, esercizio, sonno) tramite Health Connect e li invia al tuo server EverShelf in rete locale. Niente GPS grezzo. Puoi revocare i permessi in qualsiasi momento.</string>
