    <string name="wiz_welcome_title">Energia in cucina</string>
    <string name="wiz_welcome_body">Questa app collega Health Connect / Google Fit a EverShelf, così le ricette possono seguire quanto hai bruciato oggi.\n\nTutto resta sulla tua Wi‑Fi. Opzionale e privato.</string>
    <string name="wiz_perms_title">Permessi salute</string>
    <string name="wiz_perms_body">Serve solo lettura dei dati giornalieri: passi, calorie, esercizio, sonno, peso.\n\nTocca sotto per aprire Health Connect e autorizzare EverShelf Health.</string>
