{
  "name": "evershelf-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for EverShelf — pantry, shopping, recipes via AI agents",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "evershelf-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/http.js",
    "dev": "node --watch src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["mcp", "evershelf", "pantry", "home-assistant"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "fast-uri": ">=4.2.1",
    "@hono/node-server": ">=2.0.12",
    "hono": ">=4.13.13",
    "ip-address": ">=10.7.3",
    "qs": ">=6.16.0"
  }
}
