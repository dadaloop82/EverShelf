{
  "name": "evershelf-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for EverShelf — pantry, shopping, recipes via AI agents",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "evershelf-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/http.js",
    "dev": "node --watch src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["mcp", "evershelf", "pantry", "home-assistant"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "fast-uri": ">=4.2.3",
    "@hono/node-server": ">=2.1.8",
    "hono": ">=4.13.18",
    "ip-address": ">=10.7.6",
    "qs": ">=6.17.1"
  }
}
