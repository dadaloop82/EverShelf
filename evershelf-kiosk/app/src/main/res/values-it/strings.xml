    <string name="setup_lang_title">Scegli la lingua</string>
    <string name="setup_lang_subtitle">Il kiosk e l’interfaccia web useranno questa lingua.</string>
    <string name="setup_welcome_tagline">La tua dispensa smart in cucina</string>
    <string name="setup_welcome_body">Trasforma questo tablet in un pannello da cucina sempre acceso. Gestisci la dispensa, scansiona i prodotti, cucina guidato — tutto dal tuo server di casa.</string>
    <string name="setup_welcome_privacy_title">🔒 I dati restano a casa</string>
    <string name="setup_welcome_privacy_body">EverShelf gira sul tuo server. Nulla va in cloud a meno che tu non attivi servizi opzionali (Gemini, Bring!, stime prezzi).</string>
    <string name="setup_welcome_what_title">✨ Cosa configura questa guida</string>
    <string name="setup_welcome_what_body">• Collegamento al server EverShelf&#10;• Bilancia smart Bluetooth (opzionale)&#10;• Funzioni (salvaschermo, prezzi, piano pasti, zero-waste)&#10;• Gemini AI e Bring! (opzionali)&#10;&#10;Tutto viene salvato sul server: ogni dispositivo resta allineato.</string>
    <string name="setup_welcome_start">Inizia la configurazione →</string>
    <string name="setup_perms_title">Permessi</string>
    <string name="setup_perms_body">Android chiede alcuni permessi per scansione, voce e bilancia. Puoi revocarli in seguito dalle impostazioni di sistema.</string>
    <string name="setup_perms_camera_title">📷 Fotocamera</string>
    <string name="setup_perms_camera_body">Scansiona barcode e scatta foto ai prodotti quando l’etichetta non si legge.</string>
    <string name="setup_perms_mic_title">🎤 Microfono</string>
    <string name="setup_perms_mic_body">Comandi vocali opzionali e input vocale in modalità cottura.</string>
    <string name="setup_perms_ble_title">📡 Bluetooth</string>
    <string name="setup_perms_ble_body">Collega una bilancia smart da cucina. Si salta da solo se non ne usi una.</string>
    <string name="setup_perms_granted">✅ Permessi concessi</string>
    <string name="setup_perms_grant">Concedi i permessi</string>
    <string name="setup_server_title">Server EverShelf</string>
    <string name="setup_server_body">Questo tablet ha bisogno dell’URL della tua istanza EverShelf in LAN (o Tailscale/VPN). Preferisci la ricerca automatica sulla stessa Wi‑Fi.</string>
    <string name="setup_server_url_label">URL SERVER</string>
    <string name="setup_server_url_hint">http://192.168.1.100/dispensa</string>
    <string name="setup_server_test">Verifica connessione</string>
    <string name="setup_server_tip">💡 Dopo un test riuscito, il passo successivo chiede il codice di associazione (Impostazioni → Sistema → Sicurezza su un dispositivo già collegato).</string>
    <string name="setup_scale_explain">Il kiosk include un gateway BLE integrato — nessuna app Scale Gateway separata. La bilancia resta collegata ai riavvii.</string>
    <string name="setup_scale_power_title">🔋 Accendi la bilancia</string>
    <string name="setup_scale_power_body">Sveglia la bilancia, tienila vicina (circa 2 m), poi continua. Cercheremo i dispositivi e ti chiederemo di confermare una lettura di peso.</string>
    <string name="setup_scale_power_ready">Bilancia accesa — scansione →</string>
    <string name="setup_features_server_note">Queste scelte vengono scritte sul server EverShelf a fine configurazione. Telefoni e tablet vedranno le stesse opzioni.</string>
    <string name="setup_gemini_what_title">Cosa sblocca Gemini</string>
    <string name="setup_gemini_what_body">• Riconoscere prodotti da foto se il barcode fallisce&#10;• Idee ricette dalla dispensa&#10;• Suggerimenti spesa più intelligenti&#10;&#10;Usa la tua chiave gratuita di Google AI Studio. Lascia vuoto per saltare.</string>
    <string name="setup_bring_what_title">A cosa serve Bring!</string>
    <string name="setup_bring_what_body">Sincronizza la lista spesa EverShelf con l’app Bring! così tutta la famiglia condivide un’unica lista. Puoi anche usare solo la lista interna.</string>
    <string name="setup_bring_password_hint">Password Bring!</string>
    <string name="setup_done_body">Le impostazioni sono salvate sul server. Avvia EverShelf a schermo intero in modalità kiosk.</string>
