<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EverShelf.Kiosk" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnPrimary">@color/bg_dark</item>
        <item name="colorOnSecondary">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="materialButtonStyle">@style/Widget.EverShelf.Button</item>
    </style>

    <style name="Widget.EverShelf.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/bg_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="rippleColor">@color/accent_soft</item>
    </style>

    <style name="Widget.EverShelf.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minHeight">52dp</item>
        <item name="rippleColor">@color/accent_soft</item>
    </style>

    <style name="Widget.EverShelf.Button.Ghost" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.EverShelf.Button.Lang" parent="Widget.EverShelf.Button.Secondary">
        <item name="android:textSize">17sp</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="backgroundTint">@color/bg_card</item>
    </style>

    <style name="Text.EverShelf.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.EverShelf.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.EverShelf.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Text.EverShelf.Hint" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.EverShelf.Section" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
