<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:background="@color/bg_dark">
        <LinearLayout
            android:id="@+id/setupProgressDots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="start|center_vertical" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetupExit"
            style="@style/Widget.EverShelf.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_exit_btn" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/hero_glow">
        <ScrollView
            android:id="@+id/setupScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="32dp">

                <LinearLayout android:id="@+id/stepLanguage" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:visibility="visible">
                    <ImageView android:layout_width="140dp" android:layout_height="wrap_content" android:src="@drawable/ic_logo" android:adjustViewBounds="true" android:layout_marginBottom="20dp" android:contentDescription="@string/app_name" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_lang_title" android:textAppearance="@style/Text.EverShelf.Title" android:gravity="center" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_lang_subtitle" android:textAppearance="@style/Text.EverShelf.Body" android:gravity="center" android:layout_marginBottom="28dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnLangIt" style="@style/Widget.EverShelf.Button.Lang" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🇮🇹   Italiano" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnLangEn" style="@style/Widget.EverShelf.Button.Lang" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🇬🇧   English" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnLangDe" style="@style/Widget.EverShelf.Button.Lang" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🇩🇪   Deutsch" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnLangEs" style="@style/Widget.EverShelf.Button.Lang" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🇪🇸   Español" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnLangFr" style="@style/Widget.EverShelf.Button.Lang" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🇫🇷   Français" />
                </LinearLayout>

                <LinearLayout android:id="@+id/stepWelcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:visibility="gone">
                    <ImageView android:layout_width="180dp" android:layout_height="wrap_content" android:src="@drawable/ic_logo" android:adjustViewBounds="true" android:layout_marginBottom="12dp" android:contentDescription="@string/app_name" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textAppearance="@style/Text.EverShelf.Title" android:layout_marginBottom="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/setup_welcome_tagline" android:textAppearance="@style/Text.EverShelf.Subtitle" android:layout_marginBottom="16dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_welcome_body" android:textAppearance="@style/Text.EverShelf.Body" android:gravity="center" android:layout_marginBottom="16dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_accent" android:padding="16dp" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_welcome_privacy_title" android:textAppearance="@style/Text.EverShelf.Subtitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/setup_welcome_privacy_body" android:textAppearance="@style/Text.EverShelf.Hint" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="16dp" android:layout_marginBottom="20dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_welcome_what_title" android:textAppearance="@style/Text.EverShelf.Subtitle" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/setup_welcome_what_body" android:textAppearance="@style/Text.EverShelf.Hint" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnWelcomeStart" style="@style/Widget.EverShelf.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_welcome_start" />
                </LinearLayout>

                <LinearLayout android:id="@+id/stepPermissions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_perms_title" android:textAppearance="@style/Text.EverShelf.Title" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_perms_body" android:textAppearance="@style/Text.EverShelf.Body" android:layout_marginBottom="16dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="16dp" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_perms_camera_title" android:textAppearance="@style/Text.EverShelf.Subtitle" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/setup_perms_camera_body" android:textAppearance="@style/Text.EverShelf.Hint" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="16dp" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_perms_mic_title" android:textAppearance="@style/Text.EverShelf.Subtitle" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/setup_perms_mic_body" android:textAppearance="@style/Text.EverShelf.Hint" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="16dp" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_perms_ble_title" android:textAppearance="@style/Text.EverShelf.Subtitle" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/setup_perms_ble_body" android:textAppearance="@style/Text.EverShelf.Hint" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/permsGrantedCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/tip_background" android:padding="14dp" android:layout_marginBottom="12dp" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_perms_granted" android:textColor="@color/success" android:textStyle="bold" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnGrantPerms" style="@style/Widget.EverShelf.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_perms_grant" android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPermsBack"
                        style="@style/Widget.EverShelf.Button.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_step_back" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPermsNext"
                        style="@style/Widget.EverShelf.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:layout_marginStart="8dp"
                        android:text="@string/setup_step_next" />
                </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/stepServer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_server_title" android:textAppearance="@style/Text.EverShelf.Title" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_server_body" android:textAppearance="@style/Text.EverShelf.Body" android:layout_marginBottom="16dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="16dp" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_server_url_label" android:textAppearance="@style/Text.EverShelf.Section" android:layout_marginBottom="8dp" />
                        <EditText android:id="@+id/setupUrlEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:hint="@string/setup_server_url_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:background="@drawable/input_background" android:padding="14dp" android:textSize="15sp" android:singleLine="true" android:layout_marginBottom="10dp" />
                        <TextView android:id="@+id/setupUrlStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.EverShelf.Hint" android:visibility="gone" android:layout_marginBottom="10dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSetupTestUrl" style="@style/Widget.EverShelf.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_server_test" android:layout_marginBottom="8dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnDiscover" style="@style/Widget.EverShelf.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_discover_btn" />
                        <TextView android:id="@+id/discoverStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.EverShelf.Hint" android:visibility="gone" android:layout_marginTop="10dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/tip_background" android:padding="14dp" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_server_tip" android:textAppearance="@style/Text.EverShelf.Hint" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnServerBack"
                        style="@style/Widget.EverShelf.Button.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_step_back" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnServerNext"
                        style="@style/Widget.EverShelf.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:layout_marginStart="8dp"
                        android:text="@string/setup_step_next" />
                </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/stepScale" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wizard_step3_title" android:textAppearance="@style/Text.EverShelf.Title" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wizard_step3_description" android:textAppearance="@style/Text.EverShelf.Body" android:layout_marginBottom="16dp" />
                    <LinearLayout android:id="@+id/scaleQuestionCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="18dp" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wizard_step3_question" android:textAppearance="@style/Text.EverShelf.Subtitle" android:textColor="@color/text_primary" android:layout_marginBottom="8dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_scale_explain" android:textAppearance="@style/Text.EverShelf.Hint" android:layout_marginBottom="16dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnScaleYes" style="@style/Widget.EverShelf.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wizard_step3_yes" android:layout_marginBottom="8dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnScaleNo" style="@style/Widget.EverShelf.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wizard_step3_no" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/scalePowerOnCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_accent" android:padding="18dp" android:layout_marginBottom="12dp" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_scale_power_title" android:textAppearance="@style/Text.EverShelf.Subtitle" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/setup_scale_power_body" android:textAppearance="@style/Text.EverShelf.Hint" android:textColor="@color/text_secondary" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnPowerOnReady" style="@style/Widget.EverShelf.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/setup_scale_power_ready" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/bleSetupCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="16dp" android:layout_marginBottom="12dp" android:visibility="gone">
                        <TextView android:id="@+id/tvScanStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ble_scanning" android:textAppearance="@style/Text.EverShelf.Hint" android:layout_marginBottom="10dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnScanBle" style="@style/Widget.EverShelf.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ble_scan_again" android:layout_marginBottom="10dp" />
                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvScaleDevices" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
                        <TextView android:id="@+id/tvSelectedScale" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.EverShelf.Subtitle" android:visibility="gone" android:layout_marginTop="10dp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/scaleTestCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_accent" android:padding="18dp" android:layout_marginBottom="12dp" android:visibility="gone">
                        <TextView android:id="@+id/tvTestStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.EverShelf.Body" android:layout_marginBottom="12dp" />
                        <LinearLayout android:id="@+id/testWeightBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:visibility="gone" android:layout_marginBottom="12dp">
                            <TextView android:id="@+id/tvTestWeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="— g" android:textSize="36sp" android:textStyle="bold" android:textColor="@color/accent" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnTestConfirm" style="@style/Widget.EverShelf.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_confirm" android:layout_marginBottom="8dp" android:enabled="false" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnTestRetry" style="@style/Widget.EverShelf.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/install_btn_retry" android:layout_marginBottom="8dp" android:enabled="false" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnTestSkip" style="@style/Widget.EverShelf.Button.Ghost" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_skip_later" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/step3NextButtons" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone" android:layout_marginTop="8dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnScaleBack" style="@style/Widget.EverShelf.Button.Ghost" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/setup_step_back" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnScaleNext" style="@style/Widget.EverShelf.Button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" android:layout_marginStart="8dp" android:text="@string/setup_step_next" android:enabled="false" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/stepScreensaver" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_features_title" android:textAppearance="@style/Text.EverShelf.Title" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_features_desc" android:textAppearance="@style/Text.EverShelf.Body" android:layout_marginBottom="16dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setup_screensaver_toggle_label"
                            android:textAppearance="@style/Text.EverShelf.Subtitle"
                            android:textColor="@color/text_primary" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/setupSwitchScreensaver"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/setup_screensaver_toggle_hint"
                        android:textAppearance="@style/Text.EverShelf.Hint" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setup_prices_toggle_label"
                            android:textAppearance="@style/Text.EverShelf.Subtitle"
                            android:textColor="@color/text_primary" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/setupSwitchPrices"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/setup_prices_toggle_hint"
                        android:textAppearance="@style/Text.EverShelf.Hint" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setup_mealplan_toggle_label"
                            android:textAppearance="@style/Text.EverShelf.Subtitle"
                            android:textColor="@color/text_primary" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/setupSwitchMealPlan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/setup_mealplan_toggle_hint"
                        android:textAppearance="@style/Text.EverShelf.Hint" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/setup_zerowaste_toggle_label"
                            android:textAppearance="@style/Text.EverShelf.Subtitle"
                            android:textColor="@color/text_primary" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/setupSwitchZeroWaste"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/setup_zerowaste_toggle_hint"
                        android:textAppearance="@style/Text.EverShelf.Hint" />
                </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/tip_background" android:padding="14dp" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_features_server_note" android:textAppearance="@style/Text.EverShelf.Hint" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScreensaverBack"
                        style="@style/Widget.EverShelf.Button.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_step_back" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScreensaverNext"
                        style="@style/Widget.EverShelf.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:layout_marginStart="8dp"
                        android:text="@string/setup_step_next" />
                </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/stepGemini" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_gemini_title" android:textAppearance="@style/Text.EverShelf.Title" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_gemini_desc" android:textAppearance="@style/Text.EverShelf.Body" android:layout_marginBottom="12dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="16dp" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_gemini_what_title" android:textAppearance="@style/Text.EverShelf.Subtitle" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/setup_gemini_what_body" android:textAppearance="@style/Text.EverShelf.Hint" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/tip_background" android:padding="14dp" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_gemini_how" android:textAppearance="@style/Text.EverShelf.Hint" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <EditText android:id="@+id/setupGeminiKeyEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textVisiblePassword" android:hint="@string/setup_gemini_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:background="@drawable/input_background" android:padding="14dp" android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGeminiBack"
                        style="@style/Widget.EverShelf.Button.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_step_back" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGeminiSkip"
                        style="@style/Widget.EverShelf.Button.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_skip_later" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGeminiNext"
                        style="@style/Widget.EverShelf.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:layout_marginStart="8dp"
                        android:text="@string/setup_step_next" />
                </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/stepBring" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_bring_title" android:textAppearance="@style/Text.EverShelf.Title" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_bring_desc" android:textAppearance="@style/Text.EverShelf.Body" android:layout_marginBottom="12dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="16dp" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_bring_what_title" android:textAppearance="@style/Text.EverShelf.Subtitle" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/setup_bring_what_body" android:textAppearance="@style/Text.EverShelf.Hint" />
                    </LinearLayout>
                    <EditText android:id="@+id/setupBringEmailEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:hint="@string/setup_bring_email_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:background="@drawable/input_background" android:padding="14dp" android:layout_marginBottom="10dp" />
                    <EditText android:id="@+id/setupBringPasswordEdit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:hint="@string/setup_bring_password_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:background="@drawable/input_background" android:padding="14dp" android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBringBack"
                        style="@style/Widget.EverShelf.Button.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_step_back" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBringSkip"
                        style="@style/Widget.EverShelf.Button.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setup_skip_later" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBringNext"
                        style="@style/Widget.EverShelf.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:layout_marginStart="8dp"
                        android:text="@string/setup_step_next" />
                </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/stepDone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_done_title" android:textAppearance="@style/Text.EverShelf.Title" android:gravity="center" android:layout_marginBottom="8dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_done_body" android:textAppearance="@style/Text.EverShelf.Body" android:gravity="center" android:layout_marginBottom="16dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="18dp" android:layout_marginBottom="20dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_done_summary_label" android:textAppearance="@style/Text.EverShelf.Section" android:layout_marginBottom="10dp" />
                        <TextView android:id="@+id/setupSummaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.EverShelf.Body" android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnLaunch" style="@style/Widget.EverShelf.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_launch" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
